# Required — this app has no local fallback database (unlike the main
# yaCRM app, which defaults to a local PGlite dev server). Set this to the
# same hosted Postgres connection string the main app's DATABASE_URL uses
# (e.g. Supabase's pooler URL), so this service sees the same
# campaign_recipient rows the main app creates.
DATABASE_URL=

# Required for M20 completion tracking. The secret path segment in
# /webhooks/interview-complete/<secret> — the AI-interview tool's webhook
# has no signature scheme, so this URL segment is the only thing standing
# in for auth. Generate a long random value and give the tool operator the
# full URL (this app's domain + /webhooks/interview-complete/<this
# value>), not the secret alone.
INTERVIEW_WEBHOOK_SECRET=

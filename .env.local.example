# Copy to .env.local and fill in with values from Google Cloud Console.
# See README setup instructions for the Gmail OAuth client.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Voyage AI (https://www.voyageai.com/) — used to embed Events for semantic
# search/ranking. Imports still work without this (events just won't have
# an embedding), so it's optional until you need M12's campaign matching.
VOYAGE_API_KEY=

# Anthropic (https://console.anthropic.com/) — used to draft personalized
# outreach emails from a Person's history + the campaign goal. Optional
# until you need M13's draft generation.
ANTHROPIC_API_KEY=

# Optional. When unset, the app uses the local PGlite dev server
# (127.0.0.1:54329) — no setup needed, this is the default for local
# development. Set this to a real hosted Postgres connection string (e.g.
# Supabase's pooler URL, "postgresql://...@...pooler.supabase.com:6543/postgres")
# when the data needs to be visible to a deployed consumer — in particular
# apps/redirect, which records clicks against the same campaign_recipient
# rows this app creates, and can't reach 127.0.0.1 from Vercel. Must have
# the pgvector extension enabled (Supabase dashboard → Database →
# Extensions → "vector").
DATABASE_URL=

# Optional. Once apps/redirect is deployed (see apps/redirect/README.md),
# set this to its public URL (e.g. "https://yacrm-redirect.vercel.app" or
# your own subdomain) so a Campaign Recipient's tracked link — shown on
# /campaigns/[id], and later embedded in a sent email — points at the real,
# publicly reachable redirect app. Until this is set, tracked links fall
# back to this app's own /api/r/[token] route, which still works for
# manual testing from a browser but isn't reachable by a real recipient.
REDIRECT_BASE_URL=

# Required everywhere, including local dev — gates every route except
# /login behind this one shared password (see src/proxy.ts,
# src/lib/access-gate.ts). Fails closed: if this is unset, every request
# (including your own) redirects to /login with nothing that can ever
# satisfy it, rather than the gate silently passing everyone through. This
# exists because Vercel Authentication on the free Hobby plan explicitly
# does not protect a project's production custom domain, only
# preview/deployment URLs — a real gap that left this app briefly exposed
# with live Gmail access and no auth at all. Deliberately no
# environment-based bypass for local dev — one uniform rule is simpler and
# harder to accidentally get wrong than "skip the gate unless deployed."
APP_PASSWORD=

# Required for M20 completion tracking. The secret path segment in
# /api/webhooks/interview-complete/<secret> — the AI-interview tool's
# webhook has no signature scheme of its own, so this URL segment is the
# only thing standing in for auth ("treat the URL itself as the shared
# secret," per their spec). The real, publicly-reachable endpoint is in
# apps/redirect (give the tool operator that app's domain +
# /webhooks/interview-complete/<this value>) — this app's copy of the
# route is only a local-testing fallback, behind APP_PASSWORD like
# everything else here.
INTERVIEW_WEBHOOK_SECRET=

# Required for M23's follow-up job. Checked against the Authorization
# header ("Bearer <this value>") on GET /api/cron/follow-ups, scheduled
# via vercel.json's crons entry. MUST be named exactly CRON_SECRET, not
# something more specific — Vercel only auto-attaches this env var's value
# as the request's Authorization header when it's named exactly this (see
# Vercel's Cron Jobs docs); it has no way to send a custom header, so a
# differently-named var would never actually get sent by the scheduled
# invocation. Fails closed: an unset value rejects every request, same
# convention as APP_PASSWORD and INTERVIEW_WEBHOOK_SECRET above. Note this
# job never sends anything to a real recipient by itself — it only drafts
# follow-ups and emails you (via APP_BASE_URL below) a review digest; you
# log in and send each one, individually or in bulk, yourself. For a
# manual/local run, or triggering it from something other than Vercel
# Cron, just send the same header yourself.
CRON_SECRET=

# Required for M23's follow-up review digest. This app's own public URL
# (e.g. "https://yacrm.vercel.app") — used to build the links in the
# digest email so you can click straight through to the campaign that has
# follow-ups waiting for review.
APP_BASE_URL=
